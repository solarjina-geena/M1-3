# 복사해서 .env.personal / .env.team 으로 쓰세요. 실제 값은 git에 올라가지 않습니다(.gitignore).

# --- Supabase: 어느 프로젝트를 볼지 ---
# 개인 프로젝트(IMEB3 DB, 조직 CODYSSEY-M3-1 GEENA): 읽기·쓰기·스키마 적용 모두 허용
# 팀 프로젝트(mqi-m3-1-dev, ref clyjvqffabxpizkhydux): 읽기 전용
SUPABASE_PROJECT_REF=idlckjmmoysklfssotyk
SUPABASE_URL=https://idlckjmmoysklfssotyk.supabase.co
# Project Settings > API Keys. 서버(백엔드)에서만 쓰는 키. 프론트엔드에 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
# 브라우저·공개 읽기용 키 (anon / publishable)
SUPABASE_PUBLISHABLE_KEY=
# 마이그레이션·대량 적재용 직접 접속 문자열. Connect 버튼 > Session pooler 또는 Direct.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<DB비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_SCHEMA=mqi

# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- 앱 ---
DATA_SOURCE=supabase          # supabase | excel | firestore
ADMIN_API_TOKEN=              # 비상용 관리자 토큰(선택). 비워 두면 아래 이메일 로그인만 허용
# 로그인 허용 팀원 이메일(쉼표 구분). 팀 Streamlit 앱(MQI_ALLOWED_EMAILS)과 같은 규칙. 비어 있으면 이메일 로그인 불가
MQI_ALLOWED_EMAILS=
PUBLIC_URL=                   # 배포 주소(선택, 화면 표시용)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
